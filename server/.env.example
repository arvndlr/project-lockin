# For local `npm run dev` (outside Docker). Point this at the Postgres
# container: `docker compose up db` exposes it on localhost:5433 (5432 is
# remapped to avoid clashing with a locally installed Postgres, if any).

DATABASE_URL=postgresql://lockin:lockin@localhost:5433/lockin
SESSION_SECRET=dev-secret
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
